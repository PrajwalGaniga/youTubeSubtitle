# Environment variables (NEVER COMMIT API KEYS)
backend/.env
.env
*.env.local

# Job storage & temporary processed files
backend/jobs/*
!backend/jobs/.gitkeep
backend/audio_jobs/*
!backend/audio_jobs/.gitkeep

# Media files & test outputs
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3
First YT video.mp4

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
backend/__pycache__/
.venv/
venv/
env/

# Node & Frontend dependencies & build artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Antigravity & IDE artifacts
.gemini/
.system_generated/
scratch/
*.code-workspace
